# EON — ignore local secrets, caches and OS noise
.env
server/config.local.php
server/storage/logs/*
server/storage/cache/*
!server/storage/logs/.gitkeep
!server/storage/cache/.gitkeep
node_modules/
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Companion runtime state and local model binaries
ai-companion/assets/.state/
ai-companion/assets/models/*.glb


# server runtime
server/vendor/
server/composer.lock
server/storage/data/*.json
!server/storage/data/demo-dataset.json
server/storage/logs/*.log
tools/node_modules/

# deploy — created on the server, never committed
deploy/deploy.env
deploy/deploy.log
deploy/state.json
deploy/.deploy.lock/
deploy/.webhook.last
.user.ini

# ---- the ERP, deployed at the front door (its own repo's source, never edited) ----
# The source is versioned here so a push deploys it; its secrets and packages are not.
/erp/.env
/erp/.env.*
!/erp/.env.example
/erp/vendor/
/erp/node_modules/
/erp/storage/framework/
/erp/storage/logs/
/erp/storage/app/
/erp/bootstrap/cache/*
!/erp/bootstrap/cache/.gitignore
/erp/public/storage
/erp/public/build
/erp/public/hot
