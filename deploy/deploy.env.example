# EON deploy settings — copy to deploy/deploy.env on the server and edit.
#   cp deploy/deploy.env.example deploy/deploy.env && chmod 600 deploy/deploy.env
# The file is git-ignored, denied by deploy/.htaccess, and read by both
# deploy.sh (branch, publish, php, notify) and webhook.php (secret, src, publish, branch).

# the branch that is allowed to go live
branch=main

# layout B only — the document root the checkout is published into.
# Leave empty when the checkout itself is the document root (layout A).
publish=

# layout B only — where the git checkout lives (used by webhook.php to find deploy.sh)
src=

# php binary; empty = found automatically (php, php8.3, php8.2, /usr/bin/php, …)
php=

# 1 = e-mail/webhook the boss (server notify config) when a deploy FAILS
notify=1

# GitHub webhook secret — only needed for deploy/webhook.php (instant deploy).
# Generate one:  php -r 'echo bin2hex(random_bytes(24));'
secret=
