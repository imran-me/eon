# EON — document root of the site (eon.gulfrabit.com). The repo is deployed here
# as-is, so the git metadata and the deploy settings must never be readable.
DirectoryIndex index.html
Options -Indexes
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
<FilesMatch "^(\.gitignore|\.gitattributes|CLAUDE\.md|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# the toolbox and the notes are not part of the site
RedirectMatch 404 ^/(laravel|tools|docs)/
<FilesMatch "(?i)\.(sh|bash|sql|env|bak|old|orig|swp|ya?ml|log)$">
  Require all denied
</FilesMatch>

# always HTTPS — the microphone only works on a secure origin
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # voice: EON may use the microphone on its own origin, nothing else
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
  # a deploy must never leave a stale brain in the browser
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(glb|gltf|png|jpe?g|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
