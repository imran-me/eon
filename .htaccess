# EON — document root of the site (eon.gulfrabit.com). The repo is deployed here
# as-is, so the git metadata and the deploy settings must never be readable.
DirectoryIndex index.html
Options -Indexes
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
<FilesMatch "^(\.gitignore|\.gitattributes|CLAUDE\.md|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# the toolbox and the notes are not part of the site
RedirectMatch 404 ^/(laravel|tools|docs)/
<FilesMatch "(?i)\.(sh|bash|sql|env|bak|old|orig|swp|ya?ml|log)$">
  Require all denied
</FilesMatch>

# always HTTPS — the microphone only works on a secure origin
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------
#  The ERP is the front door; EON rides on it.
#
#    /            → the ERP exactly as it is (erp/public, Laravel)
#    /eon/        → EON's own panel, opened from the ERP's button
#    /server/api  → EON's API · /embed  → the companion loader
#
#  Until the ERP is placed in erp/ (see docs/erp-host.md) every one
#  of these rules is skipped — the -f test fails — and the site keeps
#  serving EON's panel, so nothing breaks in the meantime.
# ---------------------------------------------------------------
# EON's own paths — only these names are reserved; everything else belongs to the ERP
# (the ERP serves its own public/vendor/…, public/uploads/…, etc.)
RewriteRule ^(eon|app|ai-companion|embed|server|deploy)(/|$) - [L]

# the ERP's own source tree must never be reachable except through public/
RewriteRule ^erp/(?!public/) - [F,L]

# the ERP is only served once it is actually installed (its packages present)
RewriteCond %{DOCUMENT_ROOT}/erp/vendor/autoload.php !-f
RewriteRule ^ - [S=3]

# home
RewriteRule ^$ erp/public/index.php [L]

# a real file under erp/public (css, js, images, storage link) is served as-is
RewriteCond %{DOCUMENT_ROOT}/erp/public/$1 -f
RewriteRule ^(.+)$ erp/public/$1 [L]

# everything else is a Laravel route → its front controller (the URI is preserved for routing)
RewriteCond %{REQUEST_URI} !^/erp/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ erp/public/index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # voice: EON may use the microphone on its own origin, nothing else
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
  # a deploy must never leave a stale brain in the browser
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(glb|gltf|png|jpe?g|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
